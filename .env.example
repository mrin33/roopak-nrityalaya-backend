# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku)
TRUST_PROXY=0

# ─── PostgreSQL ───────────────────────────────────────────
# Either DATABASE_URL ...
# DATABASE_URL=postgres://user:password@host:5432/roopak_nrityalaya
# ... or the individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=roopak_nrityalaya
# Set to true for managed databases that require TLS (Neon, Supabase, Render)
DB_SSL=false

# ─── Auth ─────────────────────────────────────────────────
# REQUIRED, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
# Lifetime of teacher invitation / password-setup links
INVITE_TOKEN_TTL_HOURS=72

# ─── CORS / links ─────────────────────────────────────────
# Public URL of the frontend (used for CORS and invitation links).
# Several origins may be given as a comma-separated list in CORS_ORIGINS.
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://www.example.com

# ─── Uploads ──────────────────────────────────────────────
# UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
